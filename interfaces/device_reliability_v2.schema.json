{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "device_reliability_v2.schema.json",
  "title": "Device reliability delivery v2",
  "type": "object",
  "required": ["schema_version", "device_id", "device_type", "target_specific", "channels"],
  "properties": {
    "schema_version": {"const": 2},
    "device_id": {"type": "string"},
    "device_type": {"type": "string"},
    "target_specific": {"type": "boolean"},
    "claim_level": {"enum": ["target_validated", "engineering_order_of_magnitude", "scenario_only", "incomplete_lower_bound"]},
    "channels": {
      "type": "object",
      "required": ["persistent_state", "transient_read", "post_write", "correlated_macro_event", "permanent_failure"],
      "additionalProperties": false,
      "properties": {
        "persistent_state": {"$ref": "#/$defs/channel"},
        "transient_read": {"$ref": "#/$defs/channel"},
        "post_write": {"$ref": "#/$defs/channel"},
        "correlated_macro_event": {"$ref": "#/$defs/channel"},
        "permanent_failure": {"$ref": "#/$defs/channel"}
      }
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "required": ["status", "valid_for_target", "search_ready", "normalization_basis"],
      "properties": {
        "status": {"enum": ["available", "screening_only", "missing", "not_applicable"]},
        "valid_for_target": {"type": "boolean"},
        "search_ready": {"type": "boolean"},
        "normalization_basis": {"type": ["string", "null"]},
        "results": {},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
